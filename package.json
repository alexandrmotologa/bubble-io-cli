{
  "name": "bubble-io-cli",
  "version": "1.3.0",
  "description": "An open-source CLI for managing, backing up, and interacting with Bubble.io applications via the Data API",
  "author": "bubble-io-cli contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrmotologa/bubble-io-cli.git"
  },
  "homepage": "https://github.com/alexandrmotologa/bubble-io-cli#readme",
  "bugs": {
    "url": "https://github.com/alexandrmotologa/bubble-io-cli/issues"
  },
  "keywords": [
    "bubble",
    "bubble.io",
    "cli",
    "backup",
    "data-api",
    "no-code",
    "typescript"
  ],
  "bin": {
    "bubble-io-cli": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "configstore": "^6.0.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/configstore": "^6.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
